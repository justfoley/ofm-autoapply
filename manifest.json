{
  "manifest_version": 3,
  "name": "ofm-autoapply",
  "version": "0.1.0",
  "description": "Auto-applies to new ofmjobs.com postings in categories the captain selects.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://ofmjobs.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ofm-autoapply"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://ofmjobs.com/*"],
      "js": ["content/overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
